  "info": {
    "title": "SiteTrack API",
    "description": "Auth is cookie based: POST /auth/login sets httpOnly `access_token` and `refresh_token` cookies, POST /auth/refresh rotates them. Lists take `limit` (default 50, max 200) and `offset`.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "user",
              "store_manager",
              "super_admin"
            ],
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "required": [
          "role",
          "name",
          "email",
          "password"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "user",
              "store_manager",
              "super_admin"
            ],
            "type": "string"
          },
          "id": {
            "type": "string",
            "example": "7d3c1f2e-5b8a-4c6d-9e0f-1a2b3c4d5e6f"
          },
          "name": {
            "type": "string",
            "example": "Amina Diallo"
          },
          "email": {
            "type": "string",
            "example": "amina@company.com"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "role",
          "id",
          "name",
          "email",
          "createdAt"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email"
          },
          "password": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "startDate": {
            "type": "string"
          },
          "endDate": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "startDate",
          "endDate"
        ]
      },
      "ProjectDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "PRJ-0042"
          },
          "name": {
            "type": "string",
            "example": "North tower"
          },
          "startDate": {
            "type": "string",
            "example": "2026-03-01"
          },
          "endDate": {
            "type": "string",
            "example": "2026-12-15"
          },
          "isAdmin": {
            "type": "boolean",
            "description": "Whether the caller is a project admin of this project."
          },
          "memberCount": {
            "type": "number"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name",
          "startDate",
          "endDate",
          "isAdmin",
          "memberCount",
          "createdAt",
          "updatedAt"
        ]
      },
      "ProjectPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectDto"
            }
          },
          "total": {
            "type": "number",
            "description": "Total matching rows across all pages."
          },
          "limit": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ]
      },
      "UpdateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "startDate": {
            "type": "string"
          },
          "endDate": {
            "type": "string"
          }
        }
      },
      "MemberDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "isAdmin": {
            "type": "boolean"
          },
          "adminSince": {
            "format": "date-time",
            "type": "string",
            "nullable": true,
            "description": "When they became project admin; earlier = more senior. Null for regular members."
          },
          "joinedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "userId",
          "name",
          "email",
          "isAdmin",
          "adminSince",
          "joinedAt"
        ]
      }
    }
  }
}
